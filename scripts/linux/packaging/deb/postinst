#!/bin/bash
set -e
systemctl daemon-reload || true
systemctl enable vpntoris-native.service || true
systemctl restart vpntoris-native.service || systemctl start vpntoris-native.service || true
chmod 755 /run/vpntoris-native /var/log/vpntoris 2>/dev/null || true

mkdir -p /etc/vpntoris
desktop_uid=""
if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
  desktop_uid=$(id -u "$SUDO_USER" 2>/dev/null || true)
fi
if [ -z "$desktop_uid" ] && command -v loginctl >/dev/null 2>&1; then
  desktop_uid=$(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $2}' | grep -E '^[0-9]+$' | head -1 || true)
fi
if [ -n "$desktop_uid" ]; then
  touch /etc/vpntoris/helper-users.conf
  grep -qx "$desktop_uid" /etc/vpntoris/helper-users.conf 2>/dev/null || echo "$desktop_uid" >> /etc/vpntoris/helper-users.conf
  chmod 644 /etc/vpntoris/helper-users.conf
fi

if command -v glib-compile-schemas >/dev/null 2>&1; then
  glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true
fi

if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database /usr/share/applications 2>/dev/null || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
  gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
fi
echo "VPNToris installed."
echo "  Helper:  systemctl status vpntoris-native.service"
echo "  Tray:    log into a desktop session (tray auto-starts), or run: vpntoris-tray"
echo "  GNOME:   the bundled AppIndicator extension activates on next login"
echo "           (or run: gnome-extensions enable vpntoris-appindicator@vpntoris.local)"
echo "  Controller (user): systemctl --user enable --now vpntorisd.service"
