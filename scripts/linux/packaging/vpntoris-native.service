[Unit]
Description=VPNToris native privileged helper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
RuntimeDirectory=vpntoris-native
RuntimeDirectoryMode=0755
LogsDirectory=vpntoris
LogsDirectoryMode=0755
StateDirectory=
ReadWritePaths=/var/lib/vpntoris
ExecStartPre=/bin/mkdir -p /var/lib/vpntoris/engines /var/lib/vpntoris/state /var/log/vpntoris /run/vpntoris-native
ExecStart=/usr/lib/vpntoris/vpntoris-native-helper daemon 0 /var/lib/vpntoris/engines
Restart=on-failure
RestartSec=2
User=root
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=false
ProtectSystem=false
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
